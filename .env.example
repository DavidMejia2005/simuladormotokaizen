# Copy this file to .env for local development. Never commit real credentials.
OPENAI_API_KEY=sk-proj-reemplazar
DOCUMENT_DECISION_MIN_CONFIDENCE=0.80

# Integración con Odoo para leer productos reales desde el QR (?barcode=...).
# Estas variables se configuran solo en el servidor (local o Vercel).
ODOO_URL=https://tuempresa.odoo.com
ODOO_DB=tu_base_de_datos
ODOO_USERNAME=usuario@empresa.com
ODOO_API_KEY=reemplazar_por_api_key
# Opcional: tiempo de espera y caché de productos en segundos.
ODOO_TIMEOUT=8
ODOO_CACHE_TTL=60
